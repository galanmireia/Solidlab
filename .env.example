# Copia este archivo a .env y rellénalo SOLO cuando vayas a usar testnet o modo real.
# Crea claves con permiso de TRADING únicamente. NUNCA actives el permiso de retiro.
TRADEBOT_API_KEY=
TRADEBOT_API_SECRET=
# Algunos exchanges (OKX, Bitget, KuCoin) exigen además una passphrase.
TRADEBOT_API_PASSWORD=
